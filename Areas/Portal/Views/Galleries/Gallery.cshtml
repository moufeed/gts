@model GalleryDto;
@using TamTechSDK.Common.Services.ContentService.Galleries.Enums
@{
    ViewData["Title"] = Localizer["product"];
    Layout = "_Layout";
    ViewData["ImageURl"] = @Url.Content("~/portal/img/banners/galleries.jpg");
    ViewData["pageTitle"] = (!string.IsNullOrEmpty(Model.Title)) ? Model.Title : Localizer["product"].Value;
}

 
<partial name="~/Areas/Portal/Views/Shared/partials/_Header.cshtml" model="Model.Slugs" />

<partial name="~/Areas/Portal/Views/Shared/utilities/_pages_header.cshtml" />


<if include-if="Model != null && Model.Id != default(Guid)">
    <section class="product-details py-5">
        <div class="container">
            <div class="row">
                <div class="col-12">
                    <header>

                        <if include-if="!string.IsNullOrEmpty(Model.MainImage)">
                            <div class="row ">
                                <div class="col-md-4 col-lg-3">
                                    <a href="@Model.MainImage" class="pro-item-img">
                                        <img src="@Model.MainImage" alt="@Model.Title" class="img-fluid" />
                                    </a>
                                </div>
                                <div class="col-md-8 col-lg-9">
                                    <div class="meta-info">
                                        <span>
                                            <i class="fa fa-folder-o"></i>
                                            <a asp-controller="galleries" asp-action="s" asp-route-slug="@Model.Section">@Model.Section</a>
                                        </span>
                                    </div>
                                    <h1 class="border-title"><span>@Model.Title</span></h1>

                                    <div class="header-summary">
                                        @Html.Raw(Model.Summary)
                                    </div>
                                </div>
                            </div>
                        </if>
                        <if include-if="string.IsNullOrEmpty(Model.MainImage)">
                            <div class="meta-info">
                                <span>
                                    <i class="fa fa-folder-o"></i>
                                    <a asp-controller="galleries" asp-action="s" asp-route-slug="@Model.Section">@Model.Section</a>
                                </span>
                            </div>
                            <h1 class="border-title"><span>@Model.Title</span></h1>
                            <div class="header-summary">
                                @Html.Raw(Model.Summary)
                            </div>
                        </if>
                    </header>
                    <div class="product-images py-5 row">
                        <if include-if="Model.Items != null && Model.Items.Count > 0">

                            @foreach (GalleryItemDto item in Model.Items)
                            {
                                <div class="col-12 col-md-6">
                                    <div class="product-item">
                                        <figure class="item-image">
                                            <a href="@((string.IsNullOrEmpty(item.MainImage)) ? Url.Content("~/Portal/img/empty.jpg") : item.MainImage)" class="pro-item-img">
                                                <div class="hidden" style="display:none;">
                                                    <article class="img-des">
                                                        <h4><span>@item.Title</span></h4>
                                                        <div class="txt">
                                                            @Html.Raw(item.Summary)
                                                        </div>
                                                    </article>
                                                </div>
                                                <if include-if="string.IsNullOrEmpty(item.MainImage)">
                                                    <img src="~/Portal/img/empty.jpg" alt="@item.Title" class="img-fluid" />
                                                </if>
                                                <if include-if="!string.IsNullOrEmpty(item.MainImage)">
                                                    <img src="@item.MainImage" alt="@item.Title" class="img-fluid" />
                                                </if>
                                            </a>
                                        </figure>
                                        <div class="item-info">
                                            <if include-if="!string.IsNullOrEmpty(item.Title)">
                                                <h3><span>@item.Title</span></h3>
                                            </if>
                                            <if include-if="!string.IsNullOrEmpty(item.Summary)">
                                                <div class="summary">
                                                    @Html.Raw(item.Summary)
                                                </div>
                                            </if>

                                        </div>
                                    </div>
                                </div>

                            }

                        </if>
                    </div>
                </div>
            </div>
        </div>
    </section>
</if>

