@model List<SectionDto>
@{
    ViewData["Title"] = Localizer["Products"];
    Layout = "_Layout";
    ViewData["ImageURl"] = @Url.Content("~/portal/img/banners/companies.jpg");
    ViewData["pageTitle"] = Localizer["companies"];
}

    @{ 
           List<SlugModel> SectionsSlugs = new List<SlugModel>();
    }
    <partial name="~/Areas/Portal/Views/Shared/partials/_Header.cshtml" model="SectionsSlugs" />
    <partial name="~/Areas/Portal/Views/Shared/utilities/_pages_header.cshtml" />


    <if include-if="Model != null && Model.Count > 0">

        <section class="products-area  pt-100 pb-70">
            <div class="container">

                <div class="row">

                    @foreach (SectionDto sec in Model)
                    {
                        <div class="col-xl-4 col-lg-4 col-md-6 mb-30">
                            <div class="single-product text-center ">
                                
                                    <a href="@Url.Action("s", "products", new { slug = sec.SlugHierarchy }).Replace("%2F", "/")" class="product-img">
                                        @if (string.IsNullOrEmpty(sec.MainImage))
                                        {
                                            <img src="~/Portal/img/empty.jpg" />
                                        }
                                        else
                                        {
                                            <img src="@sec.MainImage" />
                                        }
                                    </a>
                                
                                <div class="product-info">
                                    <h3>
                                        <a href="@Url.Action("s", "products", new { slug = sec.SlugHierarchy }).Replace("%2F", "/")">@sec.Title</a>
                                    </h3>
                                </div>
                            </div>
                        </div>
                    }

                </div>
            </div>
        </section>
    </if>
    