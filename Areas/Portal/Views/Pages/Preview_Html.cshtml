@model PageDto

@{
    ViewData["Title"] = string.IsNullOrEmpty(Model.Title) ? Localizer["site_title"].Value : Model.Title;
    Layout = "_Layout";
    ViewData["ImageURl"] = string.IsNullOrEmpty(Model.MainImage) ? Url.Content("~/portal/img/banners/about.jpg") : @Model.MainImage;
    ViewData["pageTitle"] = @Model.Title;

    ViewBag.ItemId = Model.Id;


}
<partial name="~/Areas/Portal/Views/Shared/partials/_Header.cshtml" model="Model.Slugs" />

<partial name="~/Areas/Portal/Views/Shared/utilities/_pages_header.cshtml" />



<section class="section-page py-5">
    <div class="container">
        <div class="row">
            <div class="col ">
                @Html.Raw(Model.HtmlContent)
            </div>
        </div>
    </div>
</section>

@section SEO{
    <meta name="description" content="@Html.Raw(Model.MetaDescription)" />
    <meta name="keywords" content="@(String.Join(',', Model.Keywords))">
    <partial name="~/Areas/Portal/Views/Shared/partials/_SEO.cshtml" model="Model.SEOMarkup" />
}