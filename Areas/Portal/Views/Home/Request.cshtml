@model CreateRequestModel
@{
    ViewData["Title"] = Localizer["request_quotation"];
    Layout = "_Layout";
    ViewData["ImageURl"] = @Url.Content("~/portal/img/banners/request.jpg");
    ViewData["pageTitle"] = ViewData["Title"];
}
@{
    List<SlugModel> mod = new List<SlugModel>();
}
<partial name="~/Areas/Portal/Views/Shared/partials/_Header.cshtml" model="mod" />
<partial name="~/Areas/Portal/Views/Shared/utilities/_pages_header.cshtml" />


<section class="section-qute pt-5">
    <div class="container">
          
        <if include-if="@TempData["Success"] != null">

            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <h4 class="alert-heading">@Localizer["request_thanks_title"]</h4>

                <p>
                    @Localizer["request_thanks_msg"]
                </p>
                <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
        </if>

        <form asp-action="request" method="post" class="my-5">
            <if include-if="!ViewData.ModelState.IsValid">
                <div asp-validation-summary="All" class="alert alert-danger"></div>
            </if>
            <div class="form-row">
                <div class="col-md-6">
                    <div class="form-group ">
                        <label asp-for="FullName">@Localizer["l_full_name"]</label>
                        <input type="text" class="form-control form-control-lg" placeholder="@Localizer["l_full_name"].." asp-for="FullName" required />
                    </div>
                    <div class="form-group ">
                        <label asp-for="Email">@Localizer["l_email"]</label>
                        <input type="email" class="form-control form-control-lg" placeholder="@Localizer["l_email"].." asp-for="Email">
                    </div>

                    <div class="form-group ">
                        <label asp-for="Mobile">@Localizer["l_phone"]</label>
                        <div>
                            <input type="tel" class="form-control form-control-lg" placeholder="@Localizer["l_phone"].." asp-for="Mobile" id="phone" />
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group  ">
                        <label asp-for="Notes">@Localizer["l_notes"]</label>
                        <textarea cols="30" rows="9" class="form-control" placeholder="@Localizer["l_notes"].." asp-for="Notes"></textarea>
                    </div>
                </div>

                <input type="hidden" name="CityId" value="1" />






                <div class="form-group d-flex justify-content-between align-items-end col-md-12">

                    <button type="submit" class="btn btn-send btn-lg btn-info ">
                        @Localizer["request"]
                    </button>
                </div>

            </div>














        </form>

    </div>
</section>

@section style{
    <link href="~/Portal/css/plugins/intlTelInput.min.css" rel="stylesheet" />
}

@section footer{
    <script src="~/Portal/js/input-tel.min.js"></script>
}
