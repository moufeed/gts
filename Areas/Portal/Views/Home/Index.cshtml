
@{
    ViewData["Title"] = Localizer["site_title"];
    Layout = "_Layout";
    var lang = System.Globalization.CultureInfo.CurrentCulture.TwoLetterISOLanguageName;
}



<partial name="~/Areas/Portal/Views/Home/partials/Index/_Slider.cshtml" />
<partial name="~/Areas/Portal/Views/Home/partials/Index/_about.cshtml" />
@*<partial name="~/Areas/Portal/Views/Home/partials/Index/_services.cshtml" />*@
<partial name="~/Areas/Portal/Views/Home/partials/Index/_whyussummary.cshtml" />
<partial name="~/Areas/Portal/Views/Home/partials/Index/_quotation.cshtml" />
@*<partial name="~/Areas/Portal/Views/Home/partials/Index/_counters.cshtml" />*@
@*<partial name="~/Areas/Portal/Views/Home/partials/Index/_products.cshtml" />*@
