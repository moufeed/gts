@*<partial name="~/Areas/Portal/Views/Home/partials/Index/_clients.cshtml" />*@


@{
    PageDto pagegroup = ViewBag.groupPage;
}

<section class="portfoilo-area grey-bg pt-100 pb-70">
    <div class="container">
        <div class="row">
            <div class="col-xl-12 text-center pb-40 ">
                <div class="section-title service-title">
                    <h2>@Localizer["selected_products"]</h2>
                    @*<p>@Localizer["selected_products_txt"]</p>*@
                </div>
            </div>
        </div>

        <div class="row justify-content-center">

            @Html.Raw(pagegroup.HtmlContent)

        </div>
    </div>


</section>



@section SEO {
    <meta name="description" content="@Localizer["seo_description"]">

    <script type="application/ld+json">
        {
        "@@context": "http://schema.org",
        "@@type": "Organization",
        "url":  "@ViewBag.Host",
        "logo": "@ViewBag.Host/portal/img/logo.png",
        "name": "@Localizer["site_title"]",
        "telephone": "@Localizer["br_phone_number"]",
        description :"@Localizer["seo_description"]"
        }
    </script>
}

@section style{


}
@section footer{
    <script src="~/Portal/js/slider.min.js"></script>
    @*<script src="~/Portal/js/carousel.min.js"></script>
        <script src="~/Portal/js/counters.min.js"></script>*@
}


