  <!-- footer-area -->
    <footer class="footer-section">
        <div class="container">
            <div class="footer-cta pt-80 pb-20">
                <div class="row">
                    <div class="col-xl-4 col-md-4 mb-30">
                        <div class="single-cta">
                            <i class="fa fa-map-marker"></i>
                            <div class="cta-text">
                                <h4>@Localizer["visit_us"]</h4>
                                <span>@Localizer["full_address"]</span>
                            </div>
                        </div>
                    </div>
                    <div class="col-xl-4 col-md-4 mb-30">
                        <div class="single-cta">
                            <i class="fa fa-phone"></i>
                            <div class="cta-text">
                                <h4>@Localizer["to_contact_us"]</h4>
                                <span>@Localizer["br_phone_number"]</span>
                            </div>
                        </div>
                    </div>
                    <div class="col-xl-4 col-md-4 mb-30">
                        <div class="single-cta">
                            <i class="fa fa-envelope-open"></i>
                            <div class="cta-text">
                                <h4>@Localizer["message_us"]</h4>
                                <a href="mailto:@Localizer["br_email_adress"]">@Localizer["br_email_adress"]</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
             
        </div>

        <div class="copyright-area">
           <div class="container">
            <div class="row justify-content-between align-items-center">
                <div class="col-md-auto col-12">
                    <div class="copyright-text">
                        <p>@Localizer["copyrights"] <span class="number" dir="ltr">@(DateTime.Now.Year)</span> @Localizer["developed_designed"]  <a href="http://tamtech.solutions/" target="_blank" class="flink">@Localizer["tamtech"]</a></p>
                    </div>
                </div>
                <div class="col-md-auto col-12 text-right">
                    <ul class="d-flex top-social-links">
                        <li><a href="#"><i class="fa fa-facebook-f" aria-hidden="true"></i></a></li>
                        <li><a href="#"><i class="fa fa-twitter" aria-hidden="true"></i></a></li>
                    </ul>
                </div>
            </div>
           </div>
        </div>
 
    </footer>