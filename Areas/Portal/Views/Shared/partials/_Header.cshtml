@{
    var lang = System.Globalization.CultureInfo.CurrentCulture.TwoLetterISOLanguageName;
}

<header>
    <div class="header-top blue-bg">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-xl-6 col-lg-6 col-md-9 text-center  @(lang =="ar" ? "text-md-right" :"text-md-left")   ">
                    <div class="header-top-cta">
                        <span><i class="fa fa-map-marker"></i>@Localizer["br_address"]</span>
                        <span><i class="fa fa-envelope-open"></i>@Localizer["br_email_adress"]</span>
                        <span><i class="fa fa-phone"></i> <i dir="ltr">@Localizer["br_phone_number"]</i></span>
                    </div>
                </div>
                <div class="col-xl-6 col-lg-6 col-md-3 text-center  @(lang =="ar" ? "text-md-left" :"text-md-right")  ">
                    <div class="top-social-links">
                        <a href="#"><i class="fa fa-facebook-f"></i></a>
                        <a href="#"><i class="fa fa-twitter"></i></a>
                        <partial name="~/Areas/Portal/Views/Shared/utilities/_languages.cshtml" />
                    </div>


                </div>
            </div>
        </div>
    </div>
    <div id="sticky-header" class="menu-area">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-xl-2 col-lg-2 col-md-3 col-sm-5">
                    <div class="logo text-center">
                        <a href="#"><img src="~/Portal/img/logo.png" width="90" class="img-fluid" alt="logo"></a>
                    </div>
                </div>
                <div class="col-xl-8 col-lg-8 col-md-5 d-none d-lg-block @(lang =="ar" ? "text-right" :"text-left")  ">
                    <div class="main-menu">
                        <navbar></navbar>
                    </div>

                </div>
                <div class="col-xl-2 col-lg-2 col-md-7 text-center">
                    <a class="btn btn-consulting" asp-action="Request" asp-controller="home">@Localizer["request_quotation"]</a>
                </div>
                <div class="col-12">
                    <div class="mobile-menu"></div>
                </div>
            </div>


        </div>
    </div>
</header>