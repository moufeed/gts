@{ 
    var lang = System.Globalization.CultureInfo.CurrentCulture.TwoLetterISOLanguageName;
}
<header>
    <div class="header-top blue-bg">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-xl-6 col-lg-6 col-md-8 text-center  @(lang =="ar" ? "text-md-right" :"text-md-left")   ">
                    <div class="header-top-cta">
                        <span><i class="fa fa-map-marker"></i>@Localizer["br_address"]</span>
                        <span><i class="fa fa-envelope-open"></i>@Localizer["br_email_adress"]</span>
                        <span><i class="fa fa-phone"></i> <i dir="ltr">@Localizer["br_phone_number"]</i></span>
                    </div>
                </div>
                <div class="col-xl-6 col-lg-6 col-md-4 text-center  @(lang =="ar" ? "text-md-left" :"text-md-right")  ">
                    <div class="top-social-links">
                        <a href="#"><i class="fa fa-facebook-f"></i></a>
                        <a href="#"><i class="fa fa-twitter"></i></a>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div id="sticky-header" class="menu-area">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-xl-2 col-lg-2 col-md-3 col-sm-5">
                    <div class="logo text-center">
                        <a href="#"><img src="~/Portal/img/logo.png" width="90" class="img-fluid" alt="logo"></a>
                    </div>
                </div>
                <div class="col-xl-8 col-lg-8  @(lang =="ar" ? "text-right" :"text-right")  ">
                    <div class="main-menu">
                        <nav id="mobile-menu">
                            <ul>
                                <li><a href="#" class="menu-active">الرئيسية</a></li>
                                <li><a href="#">حول الشركة</a></li>
                                <li><a href="#">خدماتنا</a></li>
                                <li><a href="#">منتجاتنا</a></li>

                            </ul>
                        </nav>
                    </div>

                </div>
                <div class="col-xl-2 col-lg-2">
                    <a class="btn btn-consulting">@Localizer["request_quotation"]</a>
                </div>
                <div class="col-12">
                    <div class="mobile-menu"></div>
                </div>
            </div>


        </div>
    </div>
</header>